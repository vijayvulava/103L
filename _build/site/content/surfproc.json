{"version":3,"kind":"Article","sha256":"d30758c568074fe6286e0e307db6784bf657c9a79a8c2d4b73581fcdf87db24a","slug":"surfproc","location":"/06SurfProc.md","dependencies":[],"frontmatter":{"title":"6 Surface Processes","content_includes_title":false,"github":"https://github.com/vijayvulava/103L","keywords":["geology","lab manual","environmental geology"],"math":{},"thumbnail":"/c180dfcf1cd8ef53f0b00ee4186100da.html","exports":[{"format":"md","filename":"06SurfProc.md","url":"/06SurfProc-9b6114fd25e3d5b0d6f2f1c2d8008f05.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"In this lab, we will focus on geological processes occurring on Earth’s surface. These processes include weathering, erosion, and deposition. Specifically, we will also focus on how water and streams sculpt our landscapes and erode and deposit sediment. Since deposited sediment can turn into sedimentary rocks, we will also learn about the most common types of sedimentary rocks associated with these environments.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LhjXFOhOlL"}],"key":"i8zx8aFflW"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Learning Objectives","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"OE1BIao9WL"}],"identifier":"learning-objectives","label":"Learning Objectives","html_id":"learning-objectives","implicit":true,"key":"Z4Vn73CiEO"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Students will learn and demonstrate their understanding of:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"QpqWXt61jD"}],"key":"wO0oZXQhZH"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":8,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify key stream features (meanders, point bars, cut banks, floodplains, deltas).","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"yP6WWiSK21"}],"key":"TpWYh7eSvx"}],"key":"j19pYCbBIy"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Distinguish between erosion and deposition processes in stream systems.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"fFONUvO9QH"}],"key":"pSwvuGB3pY"}],"key":"HTItW0M1gs"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Relate stream behavior to gradient and topography.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"tzbZpIO613"}],"key":"CGwntAejFy"}],"key":"vhb1j5ZBu5"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Calculate sinuosity and gradient of river systems.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"fYtEAQ7GNw"}],"key":"urHVouyAHd"}],"key":"ieN5yRjbtq"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Predict sediment transport and deposition based on energy levels.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"PxqdkunjJK"}],"key":"xrCZta7iFh"}],"key":"RtkiP6Xfc9"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Interpret topographic maps and construct profiles.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Qyw2H5Hn9L"}],"key":"VQLnK6ZUsn"}],"key":"AETjOCLzIF"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Assess flood risk based on landscape features and river characteristics.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"P4QT9kZOfw"}],"key":"bsziF3m9PT"}],"key":"lQoxTYHQZV"}],"key":"tYergrV1yZ"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Watch ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"zFvW8kvvSq"},{"type":"link","url":"https://arcg.is/aSCyu","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"the StoryMap","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"rZ46bel7se"}],"urlSource":"https://arcg.is/aSCyu","key":"bPy45qKOCE"},{"type":"text","value":" below for an introduction to today’s lab topic.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"EjGeRvOcAQ"}],"key":"ehw7E1i1ti"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://storymaps.arcgis.com/stories/14b3e69384754599b37741faa298ca8a","width":"100%","key":"xZ59Aa6N9x"}],"key":"Z1psqtcJva"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Stream Features","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"WwGpbRhDW4"}],"identifier":"stream-features","label":"Stream Features","html_id":"stream-features","implicit":true,"key":"fMYzyG2bRw"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Stream landforms are features formed on the surface by stream erosion or deposition. Different types of erosion and deposition occur, and different landforms form, depending on the stream channel types. Stream channels can be straight, braided, meandering, or entrenched. The gradient, sediment load, discharge, and location of base level all influence channel type.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"OBAw526jbu"}],"key":"PNlfaCtPw9"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/gzZpZxI_F4A","width":"100%","key":"AfwxPecBjD"}],"key":"bJHabsOoNq"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"link","url":"https://opengeology.org/textbook/11-water/","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"VHiv9OuBhx"}],"urlSource":"https://opengeology.org/textbook/11-water/","key":"vtowSXSMjc"}],"key":"Y9Am8oY31v"},{"type":"heading","depth":3,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Channel Types","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"JYQJ2t00Aq"}],"identifier":"channel-types","label":"Channel Types","html_id":"channel-types","implicit":true,"key":"XoBSKPJyEq"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"strong","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Straight channels","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"kOylRN1dyk"}],"key":"vByGM5cRir"},{"type":"text","value":" are relatively straight, located near the headwaters of a stream, have steep gradients, low discharge, and narrow V-shaped valleys. Examples of these are found in most mountainous areas.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"l62yrDNIS4"}],"key":"Mwtnnwrthn"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Braided streams","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"dVf01m86Kx"}],"key":"eL53f8hHR5"},{"type":"text","value":" have multiple channels that split and recombine around countless mid-channel bars. These are found in floodplains with low gradients near sources of coarse sediment. Braided streams include trunk streams draining mountains or that develop in front of glaciers.","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"BsqRYSVqYR"}],"key":"sYdIsCLFQn"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/c180dfcf1cd8ef53f0b00ee4186100da.html","alt":"Braided stream pattern on the Waimakariri River in New Zealand. Image source","data":{"altTextIsAutoGenerated":true},"key":"V4Zj8sFNuJ","urlSource":"https://opengeology.org/textbook/wp-content/uploads/2016/07/11.7-Waimakariri01_gobeirne.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"braidedstream","identifier":"braidedstream","html_id":"braidedstream","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"AS64TkyKhm"},{"type":"text","value":"1","key":"WaLq13ivBb"},{"type":"text","value":":","key":"o0u1cV1s18"}],"template":"Figure %s:","key":"DvIfUtTvcS"},{"type":"text","value":"Braided stream pattern on the Waimakariri River in New Zealand. ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"Y9VePkhclc"},{"type":"link","url":"https://opengeology.org/textbook/wp-content/uploads/2016/07/11.7-Waimakariri01_gobeirne.jpg","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"k8Cau4C7Fm"}],"urlSource":"https://opengeology.org/textbook/wp-content/uploads/2016/07/11.7-Waimakariri01_gobeirne.jpg","key":"gmUAQT6xjI"}],"key":"ZqvVvs6j6R"}],"key":"rCmgcfJtUn"}],"class":"margin-caption","label":"braidedstream","identifier":"braidedstream","enumerator":"1","html_id":"braidedstream","key":"W7Ns8xUJLk"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Meandering streams","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"Vqyz4Cb5QD"}],"key":"jp57rNnV3K"},{"type":"text","value":", sometimes called ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"WdZ9ITNp9B"},{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"sinuous streams","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"y5ZiNIoSib"}],"key":"dEAaxo48Ag"},{"type":"text","value":", have a single channel that curves back and forth like a snake across their floodplain. Meandering streams are dynamic, creating a wide floodplain by eroding and extending meander loops side to side. The highest velocity water is found on the outside of a meander bend. Erosion of the outside of the curve creates a feature called a ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"WTQ75t0LUF"},{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"cut bank,","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"qqju4kZggC"}],"key":"I4NkGntOP0"},{"type":"text","value":" and the meander extends its loop wider by this erosion. In straighter parts of the channel, the thalweg and the highest velocity are in the channel center. But at the bend of a meandering stream, the thalweg shifts toward the cut bank. Opposite the cutbank, on the inside bend of the channel, the stream has its lowest velocity. The low velocity leads to much deposition of well-sorted, generally sand-sized but occasionally coarser, material that forms a ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"IA9spbnipa"},{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"point bar","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"dLXEahxKmo"}],"key":"O5jIOzETdq"},{"type":"text","value":". In areas of tectonic uplift, such as the Colorado Plateau, meandering streams that once flowed across the plateau surface have become entrenched, or incised, as uplift occurred while the stream cut its meandering channel into bedrock. Over the past several million years, the Colorado River and its tributaries have incised hundreds, even thousands, of feet into the flat-lying rocks of the plateau, creating deep canyons, including the Grand Canyon in Arizona.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"bK3M3ybnMT"}],"key":"S6P2ytGB6c"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/743a21df806def65a2aa2694414f3763.html","alt":"Air photo of the meandering river, Río Cauto, Cuba. Image source","data":{"altTextIsAutoGenerated":true},"key":"CMT4HvEaXr","urlSource":"https://opengeology.org/textbook/wp-content/uploads/2016/07/Rio-cauto-cuba.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"meanderingstream","identifier":"meanderingstream","html_id":"meanderingstream","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"WlIoaiPmHq"},{"type":"text","value":"2","key":"ozKiHO1cOG"},{"type":"text","value":":","key":"gp0Cl1jzx5"}],"template":"Figure %s:","key":"j92cTLIWGr"},{"type":"text","value":"Air photo of the meandering river, Río Cauto, Cuba. ","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"wrk46SOdph"},{"type":"link","url":"https://opengeology.org/textbook/wp-content/uploads/2016/07/Rio-cauto-cuba.jpg","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":58,"column":1},"end":{"line":58,"column":1}},"key":"PyxpY2Ffbp"}],"urlSource":"https://opengeology.org/textbook/wp-content/uploads/2016/07/Rio-cauto-cuba.jpg","key":"blM4FxQaaM"}],"key":"Zsr8AvwyX2"}],"key":"VMUKhHjxd7"}],"class":"margin-caption","label":"meanderingstream","identifier":"meanderingstream","enumerator":"2","html_id":"meanderingstream","key":"uOFfeNKE3o"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/a7f1bfcbe20b0e36cdfdc845b0dfbf80.html","alt":"Point bar and cut bank on the Cirque de la Madeleine in France. Image source","data":{"altTextIsAutoGenerated":true},"key":"svKCThuzR5","urlSource":"https://opengeology.org/textbook/wp-content/uploads/2017/04/11.6_CirqueMadeleine.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"pointbar","identifier":"pointbar","html_id":"pointbar","enumerator":"3","children":[{"type":"text","value":"Figure ","key":"SRlcKgEOUh"},{"type":"text","value":"3","key":"GuBZ2ccllC"},{"type":"text","value":":","key":"foqtgXOymg"}],"template":"Figure %s:","key":"J9AD2w7Zgy"},{"type":"text","value":"Point bar and cut bank on the Cirque de la Madeleine in France. ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"gL5ewLnJgd"},{"type":"link","url":"https://opengeology.org/textbook/wp-content/uploads/2017/04/11.6_CirqueMadeleine.jpg","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"pyV3H2gMmA"}],"urlSource":"https://opengeology.org/textbook/wp-content/uploads/2017/04/11.6_CirqueMadeleine.jpg","key":"LzTICa8eea"}],"key":"iTBxHQvEzt"}],"key":"ySSNpFryCX"}],"class":"margin-caption","label":"pointbar","identifier":"pointbar","enumerator":"3","html_id":"pointbar","key":"ew9PPVBard"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"Through erosion on the outsides of the meanders and deposition on the insides, the channels of meandering streams move back and forth across their floodplain over time. On very broad floodplains with very low gradients, the meander bends can become so extreme that they cut across themselves at a narrow neck (see figure) called a ","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"N3ROBcUG0M"},{"type":"strong","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"cutoff","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"WIGTLSPcQ0"}],"key":"FpfQxy34Vg"},{"type":"text","value":". The former channel becomes isolated and forms an ","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"WNpidmQ2Ub"},{"type":"strong","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"oxbow lake","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"sAZaQRICR0"}],"key":"o7sc079nKe"},{"type":"text","value":" seen on the right of the figure. Eventually, the oxbow lake fills in with sediment, becoming a wetland and, ultimately, a ","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"UKUNpI0JQw"},{"type":"strong","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"meander scar","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"Fx8x76JbYr"}],"key":"HRZ5xItaGU"},{"type":"text","value":". Stream meanders can migrate and form oxbow lakes in a relatively short amount of time. Where stream channels form geographic and political boundaries, channel shifts can cause conflicts.","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"jzKk0g1g15"}],"key":"aarzWCE7Oa"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/7e5823ceae0d493864753d8e6e5940cc.html","alt":"Meander nearing cutoff on the Nowitna River in Alaska. Image source","data":{"altTextIsAutoGenerated":true},"key":"Y28BeX80U1","urlSource":"https://opengeology.org/textbook/wp-content/uploads/2018/03/Nowitna_river-with-approaching-cutoff-768x541.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"oxbow","identifier":"oxbow","html_id":"oxbow","enumerator":"4","children":[{"type":"text","value":"Figure ","key":"KpVdjFBvMu"},{"type":"text","value":"4","key":"FHlvNdw5CU"},{"type":"text","value":":","key":"SiZzi6rDP5"}],"template":"Figure %s:","key":"Z1qU3NUKvM"},{"type":"text","value":"Meander nearing cutoff on the Nowitna River in Alaska. ","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"JVwI5d43oZ"},{"type":"link","url":"https://opengeology.org/textbook/wp-content/uploads/2018/03/Nowitna_river-with-approaching-cutoff-768x541.jpg","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"FkSwI1TPxK"}],"urlSource":"https://opengeology.org/textbook/wp-content/uploads/2018/03/Nowitna_river-with-approaching-cutoff-768x541.jpg","key":"X2zzzXNbx9"}],"key":"aysvlsk9AJ"}],"key":"gaRj27doqY"}],"class":"margin-caption","label":"oxbow","identifier":"oxbow","enumerator":"4","html_id":"oxbow","key":"LRnuKHR1wK"},{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"link","url":"https://opengeology.org/textbook/11-water/","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"y9aQ8xxu0c"}],"urlSource":"https://opengeology.org/textbook/11-water/","key":"rcDCagDa3n"}],"key":"b96NmN88FB"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/8a3r-cG8Wic","width":"100%","key":"jYJRFHCs1Z"}],"key":"MKqNMt7jwz"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"A delta is formed when a stream reaches the ocean, or a quieter body of water such as a lake. In deltas, the bedload and suspended load are deposited because stream velocity slows. If wave erosion from the ocean, or other water body, is greater than deposition from the river, a delta will not form. But deltas form in most cases. The largest and most famous delta in the United States is the Mississippi River delta, formed where the Mississippi River flows into the Gulf of Mexico. The Mississippi River drainage basin is the largest in North America, draining 41% of the contiguous United States.","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"pmHpa18PtK"}],"key":"D45knlFOTW"},{"type":"paragraph","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"link","url":"https://opengeology.org/textbook/11-water/","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"KwKTMsUY45"}],"urlSource":"https://opengeology.org/textbook/11-water/","key":"HlR7qCUbC9"}],"key":"d8ofuS1hQM"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/217f7db8f992a3ed0138c82bb6102ab8.html","alt":"Location of the Mississippi River drainage basin and Mississippi River delta. Image source","data":{"altTextIsAutoGenerated":true},"key":"WeZ7yy9ncN","urlSource":"https://opengeology.org/textbook/wp-content/uploads/2016/07/11.6_Mississippiriver-new-01.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"ms-watershed","identifier":"ms-watershed","html_id":"ms-watershed","enumerator":"5","children":[{"type":"text","value":"Figure ","key":"q5fRqM0PpA"},{"type":"text","value":"5","key":"lGaEjoo9Ji"},{"type":"text","value":":","key":"rTexAUuHSa"}],"template":"Figure %s:","key":"efjfeWxZOz"},{"type":"text","value":"Location of the Mississippi River drainage basin and Mississippi River delta. ","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"eADw9XOvxY"},{"type":"link","url":"https://opengeology.org/textbook/wp-content/uploads/2016/07/11.6_Mississippiriver-new-01.png","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":100,"column":1},"end":{"line":100,"column":1}},"key":"DazuR3NZa6"}],"urlSource":"https://opengeology.org/textbook/wp-content/uploads/2016/07/11.6_Mississippiriver-new-01.png","key":"z9uKtiCPkK"}],"key":"rNILOrq1iv"}],"key":"hIlDBhh6lg"}],"class":"margin-caption","label":"ms-watershed","identifier":"ms-watershed","enumerator":"5","html_id":"ms-watershed","key":"hZdGib5U0O"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/mzoPBKTt64Q","width":"100%","key":"mN17elmsNP"}],"key":"uGSBiAt5Kq"},{"type":"heading","depth":2,"position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"Topography and Streams","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"zXznUVciQ4"}],"identifier":"topography-and-streams","label":"Topography and Streams","html_id":"topography-and-streams","implicit":true,"key":"gaOSjuLMTQ"},{"type":"paragraph","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"Understanding stream behavior requires a good grasp of the region’s topography. Geologists use topographic maps to show the topography of an area. In the two videos below, the narrators describe different features to look for in a topographical map and how such maps can be used in practical settings ","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"fubTTn26xH"},{"type":"strong","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"(your text).","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"yrTmIKUJgj"}],"key":"LbDfPaVbDJ"}],"key":"TMQrlXhzpN"},{"type":"paragraph","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"text","value":"A stream that flows on a wide, flat floodplain with a low gradient typically carries only sand-sized and finer sediments and develops a sinuous (curvy) flow pattern. When a stream flows around a corner, the water on the outside has farther to go and tends to flow faster. This leads to erosion of the banks on the outside of the curve, deposition on the inside, and the formation of a point bar. Over time, the stream’s sinuosity becomes increasingly pronounced, and the channel migrates within its floodplain, forming a meandering pattern.","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"ZM53b78qPN"}],"key":"oEwfWpQ3Hb"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Streams that flow in steeper terrain or high-gradient streams can carry larger sediment and may form deep incised channels as well as braided streams. Such streams are typical in the headwater sections of a stream system ","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"FX2Z33YyNR"},{"type":"strong","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"(your text).","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"rNlLfXqwEo"}],"key":"uK7U8mbCit"}],"key":"m6g908vVEz"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/0MtW6gRCbn0","width":"100%","key":"Y82N9tbclG"}],"key":"zolFv2Uzxw"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/CoVcRxza8nI","width":"100%","key":"KeQZega8vq"}],"key":"Zc3oJZOrmb"},{"type":"paragraph","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"The figure below provides a basic conceptualization of a river system that originates in mountains (headwaters) and discharges into an ocean (mouth).","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"aZzuDL6VXL"}],"key":"q8wBAWRpyO"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/Stream-System-0da854aa88ad02ecee41038651642bb0.png","alt":"Conceptualization of stream systems from headwaters to the mouth. The inset shows a stream’s longitudinal profile or how the slope of the river changes over its length. Image Source: Author","data":{"altTextIsAutoGenerated":true},"key":"cPIEFaAGCV","urlSource":"assets/Stream-System.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"stream-sys","identifier":"stream-sys","html_id":"stream-sys","enumerator":"6","children":[{"type":"text","value":"Figure ","key":"vvNSVRCSOG"},{"type":"text","value":"6","key":"gHwYBTsNKx"},{"type":"text","value":":","key":"msUCKnxSUc"}],"template":"Figure %s:","key":"lyz1FN1Tz5"},{"type":"text","value":"Conceptualization of stream systems from headwaters to the mouth. The inset shows a stream’s longitudinal profile or how the slope of the river changes over its length. Image Source: Author","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"CHABDppmHu"}],"key":"HlZHUrN1af"}],"key":"MWxXNZxT2o"}],"class":"margin-caption","label":"stream-sys","identifier":"stream-sys","enumerator":"6","html_id":"stream-sys","key":"QWb7ayMTTQ"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"strong","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"Sinuosity","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"reFWYEZ2w3"}],"key":"Ld2xfLZE9R"},{"type":"text","value":" = channel length/straight line length","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"rypkeNzyCZ"}],"key":"ddFfBpyjxX"},{"type":"paragraph","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"strong","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"children":[{"type":"text","value":"Gradient","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"JFe2tBBt0l"}],"key":"ndp8nuXvXZ"},{"type":"text","value":" = vertical drop/straight line length","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"FRXenQbZnV"}],"key":"eOuvT3nz0N"},{"type":"heading","depth":2,"position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Sediment Transport and Deposition","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"MQ29PjSpPw"}],"identifier":"sediment-transport-and-deposition","label":"Sediment Transport and Deposition","html_id":"sediment-transport-and-deposition","implicit":true,"key":"PdwLlz3d8i"},{"type":"paragraph","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"children":[{"type":"text","value":"Geologically, a ","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"G3AUgtPMVW"},{"type":"strong","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"children":[{"type":"text","value":"stream","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"wNvIrTAtbp"}],"key":"GG71IlYwVo"},{"type":"text","value":" is a body of flowing surface water confined to a channel. Terms such as river, creek, and brook are less specific terms not used a great deal by geologists. Streams erode and transport sediments, making them the most important agents, along with wave action, that erode and transport sediments on Earth’s surface. They create much of the surface topography and are an important water resource.","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"UflvkZYTCs"}],"key":"czyp18GtH1"},{"type":"paragraph","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"Several factors cause streams to erode and transport sediment, but the two main factors are ","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"K959p6tUwA"},{"type":"strong","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"stream-channel gradient","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"CPrltfzn2b"}],"key":"TS1a4wrDtB"},{"type":"text","value":" and ","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"v97PRApWUe"},{"type":"strong","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"children":[{"type":"text","value":"velocity","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"qnWrwwrGDA"}],"key":"wzA0RTyhNx"},{"type":"text","value":". Stream-channel gradient is the slope of the stream, usually expressed in meters per kilometer or feet per mile. A steeper channel gradient promotes erosion. When tectonic forces elevate a mountain, the stream gradient increases, causing the mountain stream to erode downward and deepen its channel, eventually forming a valley. Stream-channel velocity is the speed at which channel water flows. Factors affecting channel velocity include channel gradient, which decreases downstream; discharge, which increases as tributaries coalesce; channel size, which increases as tributaries coalesce; and channel roughness, which decreases as the sediment lining the channel walls becomes finer, thus reducing friction. Consequently, streams have some stretches that flow faster than others. Overall, the combined effect of all factors is that channel velocity, on average, increases from mountain brooks to the stream’s mouth.","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"Ohsc8vn7et"}],"key":"t3OZZih44U"},{"type":"paragraph","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"children":[{"type":"text","value":"Streams transport sediment great distances from the headwaters to the ocean, the ultimate depositional basins. Sediment transportation is directly related to stream gradient and velocity. Faster and steeper streams can transport larger sediment grains. As velocity decreases, larger sediments settle to the channel bottom. As velocity increases, larger sediments are entrained and move again.","position":{"start":{"line":146,"column":1},"end":{"line":146,"column":1}},"key":"mpl7nv6tP5"}],"key":"oyHPF6VITv"},{"type":"paragraph","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"children":[{"type":"text","value":"Transported sediments may be part of the bedload, the suspended load, or the dissolved load, as illustrated in the above image. Sediments moved along the channel bottom are the bedload. Bedload materials typically consist of the largest and densest particles being transported. The particles are moved by saltation (bouncing) and traction (being pushed or rolled along by the flow). Above the bedload, smaller particles are picked up by flowing water and carried in suspension as suspended load. The particle sizes carried in suspension and bedload depend on the stream’s flow velocity. Dissolved load in a stream is the total of the ions in solution from chemical weathering, including such common ions such as bicarbonate (HCO3–), calcium (Ca+2), chloride (Cl-1), potassium (K+1), and sodium (Na+1). The amounts of these ions are not affected by flow velocity.","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"b8jss7YPUP"}],"key":"gjL8opEyO0"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/jGhogd0G7_U","width":"100%","key":"KINv0EJjMN"}],"key":"SCt8cCIL91"},{"type":"paragraph","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"children":[{"type":"link","url":"https://opengeology.org/textbook/11-water/","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":155,"column":1},"end":{"line":155,"column":1}},"key":"isfBEA3mcN"}],"urlSource":"https://opengeology.org/textbook/11-water/","key":"JYZeT3NbQC"}],"key":"LQDlGpT7RC"},{"type":"heading","depth":2,"position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"Flooding","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"key":"cqdMIKSjGn"}],"identifier":"flooding","label":"Flooding","html_id":"flooding","implicit":true,"key":"dKOVGnp2K9"},{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"During floods, streams may overflow their normal channels. This flooding deposits sediment, creating a flat-lying floodplain adjacent to a stream. Floodplains may be narrow or huge depending on stream size and other characteristics. A stream typically reaches its greatest velocity when it is close to flooding, known as the bankfull stage. As soon as the flooding stream overtops its banks and flows onto its floodplain, the velocity decreases. Sediment that was being carried by the swiftly moving water may be deposited at the edge of the channel, forming a low ridge or natural levee. In addition, sediments are added to the floodplain during this flooding process, contributing to fertile soils.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"fVgX8BTcJU"}],"key":"Y0Jxwvw9tK"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/2e612bd8eb7376c702e2fb6ce6d03aba.html","alt":"Profile of stream channel at bank-full stage, flood stage, and deposition of natural levee . Image source","data":{"altTextIsAutoGenerated":true},"key":"V6NChzj7CN","urlSource":"https://opengeology.org/textbook/wp-content/uploads/2016/07/natural-lev%C3%A9es.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"bankfull","identifier":"bankfull","html_id":"bankfull","enumerator":"7","children":[{"type":"text","value":"Figure ","key":"bEMNIXKk40"},{"type":"text","value":"7","key":"vizkqU0dCe"},{"type":"text","value":":","key":"kOiX9sjWOK"}],"template":"Figure %s:","key":"xGwCm2SUeu"},{"type":"text","value":"Profile of stream channel at bank-full stage, flood stage, and deposition of natural levee . ","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"BJCWTc6yo2"},{"type":"link","url":"https://opengeology.org/textbook/wp-content/uploads/2016/07/natural-lev%C3%A9es.png","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"rUDGnqDjk0"}],"urlSource":"https://opengeology.org/textbook/wp-content/uploads/2016/07/natural-lev%C3%A9es.png","key":"CyFgMPG11z"}],"key":"nFxWnAFOsP"}],"key":"hQ6WFuJ2ti"}],"class":"margin-caption","label":"bankfull","identifier":"bankfull","enumerator":"7","html_id":"bankfull","key":"dMWyJE6c72"},{"type":"paragraph","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"link","url":"https://opengeology.org/textbook/11-water/","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":169,"column":1},"end":{"line":169,"column":1}},"key":"qwsTvIZ3Je"}],"urlSource":"https://opengeology.org/textbook/11-water/","key":"CSTaEgyYWG"}],"key":"fFKlviD0CF"}],"key":"lMeDGoHqTC"}],"key":"q5vjc1gO1v"},"references":{"cite":{"order":[],"data":{}}}}