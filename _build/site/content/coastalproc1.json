{"version":3,"kind":"Article","sha256":"fd98e7a1c978d035979eebe9ffee6fe1a9bf7da26eaf42ab92ca779f6477a69b","slug":"coastalproc1","location":"/07CoastalProc1.md","dependencies":[],"frontmatter":{"title":"7 Coastal Processes","content_includes_title":false,"github":"https://github.com/vijayvulava/103L","keywords":["geology","lab manual","environmental geology"],"math":{},"thumbnail":"/209238a8958716aa14ed018a56546014.html","exports":[{"format":"md","filename":"07CoastalProc1.md","url":"/07CoastalProc1-84235e2da11a09c890ca83aa046d9a2d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"In this lab, we will explore the dynamic processes that shape our coastlines. We will learn how waves, tides, currents, and sediment transport create and modify coastal landforms, as well as how human activities influence coastal erosion and management.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"XgnlZNusIF"}],"key":"MHj2ZJkRbM"},{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Learning Objectives","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"BxEmzcxdc6"}],"identifier":"learning-objectives","label":"Learning Objectives","html_id":"learning-objectives","implicit":true,"key":"DhwlQTOmpC"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Students will learn and demonstrate their understanding of:","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Df54RitfN3"}],"key":"ysMuuGUOCr"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":9,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Differentiate between active and passive continental margins.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"xuC124fMcI"}],"key":"XomNZgUgg4"}],"key":"Tsv9dhstyM"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Interpret coastal topography and bathymetry.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"K27UmreqRi"}],"key":"h05fNoLENs"}],"key":"AbOXkzgy1H"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Explain processes shaping coastlines, including waves, tides, and currents.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"zf3J45o4xm"}],"key":"WR4S5Isueg"}],"key":"aSEK0744nd"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Describe longshore drift and sediment transport.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"ePJa0ZLLqD"}],"key":"ZUA8pz4jVh"}],"key":"EcBLtI4Isz"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Analyze coastal landforms such as barrier islands, marshes, and inlets.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"OYLrTyUdpN"}],"key":"FIyLOgesEI"}],"key":"Zxk2YIW4nx"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Evaluate coastal erosion and deposition patterns.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"AxVe1eX9J6"}],"key":"nJge9yTIvH"}],"key":"k0x3h9nBY6"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Assess human impacts and coastal management strategies.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"W4oJf2EHEo"}],"key":"YXpmWyg2aQ"}],"key":"tFDQ4eD7Y8"}],"key":"QkpvLORyiY"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Watch ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"PS5zNcNsCr"},{"type":"link","url":"https://arcg.is/SCmLW","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"the StoryMap","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"LXbzI8exMp"}],"urlSource":"https://arcg.is/SCmLW","key":"GbyanDyPdm"},{"type":"text","value":" below for an introduction to today’s lab topic.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"Ssyp776f3z"}],"key":"XDy7Zd5pK1"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://storymaps.arcgis.com/stories/f4cfac34958b4275adf38c4e4f3ac9a1","width":"100%","key":"Il9SCmwQIC"}],"key":"bYlNarWcwz"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Coastlines","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"F310TedKQD"}],"identifier":"coastlines","label":"Coastlines","html_id":"coastlines","implicit":true,"key":"hsPTyf9v4X"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Approximately 50% of the world’s population lives within 100 km of a coastline. Many coastal areas are centers of economic activity and serve as major hubs for trade, transportation, and tourism. Coastlines provide a wide range of valuable natural resources, including fisheries and deposits of minerals, oil, and gas. Coastal ecosystems, such as salt marshes, mangrove forests, and coral reefs, provide important ecological services and act as buffers against storm surges and erosion, protecting inland areas from the impact of hurricanes and other natural disasters. Coastal areas provide scenic landscapes and natural beauty, attracting tourists and providing a sense of relaxation and well-being. Coastlines often hold cultural and historical significance for human populations. They have been important habitats for indigenous communities and are associated with cultural practices, traditions, and livelihoods. Coastal regions also feature historical sites, archaeological remains, and landmarks that contribute to a place’s cultural heritage.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"yTSXKmQGxS"}],"key":"QUhVYnTTJg"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Coastlines are vulnerable to various environmental challenges, including erosion, sea-level rise, and pollution. It is crucial to manage and protect these areas sustainably to ensure their continued benefits for future generations.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"Dbyf2TL7nL"}],"key":"zg7Fh5iLI9"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"In this and the next lab, we will learn about basic geological processes that occur along coastlines similar to Charleston’s and how natural and anthropogenic factors affect our coastlines.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"io9W8VPJt2"}],"key":"EIv0O7owuW"},{"type":"heading","depth":2,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Types of Coasts","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"SQVbxucmuv"}],"identifier":"types-of-coasts","label":"Types of Coasts","html_id":"types-of-coasts","implicit":true,"key":"mJQmsvwA56"},{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Emergent coasts occur where sea levels fall relative to land level. Submergent coasts occur where sea levels rise relative to land level. Tectonic shifts and sea level changes cause the long-term rise and fall of sea level relative to land. Some features associated with emergent coasts include high cliffs, headlands, exposed bedrock, steep slopes, rocky shores, arches, stacks, tombolos, wave-cut platforms, and wave notches.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"zbU67gdCQn"}],"key":"gcz65RPgOE"},{"type":"heading","depth":3,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Active/Emergent","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"lp1GwihO5a"}],"identifier":"active-emergent","label":"Active/Emergent","html_id":"active-emergent","implicit":true,"key":"xrIVVWuV1M"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"In emergent coasts, wave energy, wind, and gravity erode the coastline. The erosional features are elevated relative to the wave zone. Sea cliffs are persistent features as waves cut away at their base and higher rocks calve off by mass wasting. Refracted waves that attack bedrock at the base of headlands may erode or carve out a sea arch, which can extend below sea level in a sea cave. When a sea arch collapses, it leaves one or more rock columns called stacks.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"lYlRJeNGeQ"}],"key":"P4UzhHCao2"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/209238a8958716aa14ed018a56546014.html","alt":"Wave notches carved by Lake Bonneville, Antelope Island, Utah. Image source","data":{"altTextIsAutoGenerated":true},"key":"gEVcC9teey","urlSource":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/WaveCutPlatformsAntelopeIslandUT-300x104.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"wavenotch","identifier":"wavenotch","html_id":"wavenotch","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"L2cZnHACrc"},{"type":"text","value":"1","key":"CQXH13Ptgf"},{"type":"text","value":":","key":"y9r7srcr9E"}],"template":"Figure %s:","key":"UcalyRup0j"},{"type":"text","value":"Wave notches carved by Lake Bonneville, Antelope Island, Utah. ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"imWRgr7qYK"},{"type":"link","url":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/WaveCutPlatformsAntelopeIslandUT-300x104.jpg","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"dRbw5W0Gfv"}],"urlSource":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/WaveCutPlatformsAntelopeIslandUT-300x104.jpg","key":"qSQJbXDXnc"}],"key":"MxeN5MQU45"}],"key":"BdSRCYcxNI"}],"class":"margin-caption","label":"wavenotch","identifier":"wavenotch","enumerator":"1","html_id":"wavenotch","key":"pykdKx4VdZ"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"A stack or near shore island creates a quiet water zone behind it.  Sand moving in the longshore drift accumulates in this quiet zone forming a tombolo: a sand strip that connects the island or stack to the shoreline. Where sand supply is low, wave energy may erode a wave-cut platform across the surf zone, exposed as bare rock with tidal pools at low tide. This bench-like terrace extends to the cliff’s base. When wave energy cuts into the base of a sea cliff, it creates a wave notch.","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"bPdQ0Km60b"}],"key":"msoQactRPI"},{"type":"heading","depth":3,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Passive/Submergent","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"VlcdprVbjE"}],"identifier":"passive-submergent","label":"Passive/Submergent","html_id":"passive-submergent","implicit":true,"key":"HyxbF8ciE5"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Submergent coasts occur where sea levels rise relative to land. This may be due to tectonic subsidence—when the Earth’s crust sinks—or when sea levels rise due to glacier melt. Features associated with submergent coasts include flooded river mouths, fjords, barrier islands, lagoons, estuaries, bays, tidal flats, and tidal currents. In submergent coastlines, river mouths are flooded by the rising water, for example Chesapeake Bay. Fjords are glacial valleys flooded by post-ice age sea level rise. Barrier islands are elongated bodies of sand that formed from old beach sands that used to parallel the shoreline. Often, lagoons lie behind barrier islands. Barrier island formation is controversial: some scientists believe that they formed when ice sheets melted after the last ice age, raising sea levels. Another hypothesis is that barrier islands formed from spits and bars accumulating far offshore.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"de0l65NP0a"}],"key":"NrPc24EYpD"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"link","url":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"zUrtcsmcMr"}],"urlSource":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","key":"Z2smXW71mR"}],"key":"UrnN9R4Tom"},{"type":"heading","depth":3,"position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"Forces that shape the coast","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"u0s3a2dnQ9"}],"identifier":"forces-that-shape-the-coast","label":"Forces that shape the coast","html_id":"forces-that-shape-the-coast","implicit":true,"key":"P1l7zF59Fc"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/u-MFerc-pis","width":"100%","key":"Dmb1229TlK"}],"key":"kfi5UjbQh4"},{"type":"heading","depth":3,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Longshore Transport/Waves","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"pGpihI8JIc"}],"identifier":"longshore-transport-waves","label":"Longshore Transport/Waves","html_id":"longshore-transport-waves","implicit":true,"key":"D5pxF4DDFK"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"As waves enter shallower water less than one-half wavelength depth, they slow down. Waves usually approach the shoreline at an angle, with the end of the waves nearest the beach slowing down first. This causes the wave crests to bend,  called wave refraction. From the beach face, this causes it to look like waves are approaching the beach straight on, parallel to the beach. However, as refracted waves actually approach the shoreline at a slight angle, they create a slight difference between the swash as it moves up the beach face at a slight angle and the backwash as it flows straight back down under gravity. This slight angle between swash and backwash along the beach creates a current called the longshore current. Waves stir up sand in the surf zone and move it along the shore. This movement of sand is called longshore drift. Longshore drift along both the west and east coasts of North America moves sand north to south on average.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"O4aRoSK27z"}],"key":"kILudDfRCo"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/5f221d589756a26b39e5352210166a58.png","alt":"Longshore drift along a coastline. Image source","data":{"altTextIsAutoGenerated":true},"key":"ZkMqQsCgtU","urlSource":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Longshore_drift.svg/330px-Longshore_drift.svg.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"longshore","identifier":"longshore","html_id":"longshore","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"WtWg0SLPaf"},{"type":"text","value":"2","key":"pED1d4dxIi"},{"type":"text","value":":","key":"mN5kZ7Alci"}],"template":"Figure %s:","key":"XVX4HbrElY"},{"type":"text","value":"Longshore drift along a coastline. ","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"x4ZyA6Qlkp"},{"type":"link","url":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Longshore_drift.svg/330px-Longshore_drift.svg.png","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"WeXm2eEGoe"}],"urlSource":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Longshore_drift.svg/330px-Longshore_drift.svg.png","key":"Rk0SebAeLV"}],"key":"fBjMAbmn84"}],"key":"eNeH0DSXR6"}],"class":"margin-caption","label":"longshore","identifier":"longshore","enumerator":"2","html_id":"longshore","key":"yUi20dEgyI"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"Longshore currents can carry longshore drift down a coast until it reaches a bay or inlet where it will deposit sand in the quieter water. Here, a spit can form. As the spit grows, it may extend across the mouth of the bay forming a barrier called a baymouth bar. Where the bay or inlet serves as boat anchorage, spits and baymouth bars are a severe inconvenience. Often, inconvenienced communities create methods to keep their bays and harbors open.","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"Bd6cfafFXn"}],"key":"PjoU13xGEc"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/e17478a61cb41b6f65f7baf36e352af7.html","alt":"Farewell Spit, New Zealand. Image source","data":{"altTextIsAutoGenerated":true},"key":"N2uYl21z8J","urlSource":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/FarewellSpitNZ.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"spit","identifier":"spit","html_id":"spit","enumerator":"3","children":[{"type":"text","value":"Figure ","key":"Xih7khfyJl"},{"type":"text","value":"3","key":"HmzOOWi5Ud"},{"type":"text","value":":","key":"bRyXEnHheW"}],"template":"Figure %s:","key":"pAF5YyYagN"},{"type":"text","value":"Farewell Spit, New Zealand. ","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"eRjcPPp1up"},{"type":"link","url":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/FarewellSpitNZ.jpg","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"aW8GGBYy60"}],"urlSource":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/FarewellSpitNZ.jpg","key":"nRf5ukd0b9"}],"key":"wydtxMOG3N"}],"key":"soaK71U3D4"}],"class":"margin-caption","label":"spit","identifier":"spit","enumerator":"3","html_id":"spit","key":"vSWzn9WMdd"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"link","url":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"OMVn07b2HI"}],"urlSource":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","key":"pBg7AASgBQ"}],"key":"swIm9PY1XK"},{"type":"heading","depth":3,"position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Tides","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"u6TKkaa8ng"}],"identifier":"tides","label":"Tides","html_id":"tides","implicit":true,"key":"axzMfZcSTc"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"Tides are the rising and lowering of sea level during the day and are caused by the gravitational effects of the Sun and Moon on the oceans. The Earth rotates daily within the Moon and Sun’s gravity fields. Although the Sun is much larger and its gravitational pull is more powerful, the Moon is closer to Earth; hence, the Moon’s gravitational influence on tides is dominant. The magnitude of the tide at a given location and the difference between high and low tide—the tidal range, depends primarily on the configuration of the Moon and Sun with respect to the Earth orbit and rotation. Spring tide occurs when the Sun, Moon, and Earth line up with each other at the full or new Moon, and the tidal range is at a maximum. Neap tide occurs approximately two weeks later when the Moon and Sun are at right angles with the Earth, and the tidal range is lowest. There are three types of tidal patterns: diurnal, semidiurnal, and mixed. Typical tidal ranges are approximately 1 m (3 ft). Extreme tidal ranges are around 18 m (60 ft).","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"ZO39oVc00X"}],"key":"BcGtoV94GF"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/a68fbbce3d20d346964b448ebf533c48.html","alt":"Relative orientation of sun, moon, and Earth resulting in tides of various magnitudes. Image source","data":{"altTextIsAutoGenerated":true},"key":"uO34nqIdNI","urlSource":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/Tide_schematic.svg_.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"Relative orientation of sun, moon, and Earth resulting in tides of various magnitudes. ","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"WwcAx9LElF"},{"type":"link","url":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/Tide_schematic.svg_.png","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":98,"column":1},"end":{"line":98,"column":1}},"key":"x7gJeAGWIC"}],"urlSource":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/Tide_schematic.svg_.png","key":"mih2R4B32H"}],"key":"iWhK3vxdUn"}],"key":"r0yRdf8yjA"}],"class":"margin-caption","label":"tides","identifier":"tides","enumerator":"4","html_id":"tides","key":"ZnUYRdGW0U"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/3c2184fb5e003d8e1169a3deb477daf1.html","alt":"Distribution of tidal phases for different tidal types. Image source","data":{"altTextIsAutoGenerated":true},"key":"JSTVEXGIyG","urlSource":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/Tide_type.svg_.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"tidalphase","identifier":"tidalphase","html_id":"tidalphase","enumerator":"5","children":[{"type":"text","value":"Figure ","key":"UylNbMctoZ"},{"type":"text","value":"5","key":"wAmotZcrw3"},{"type":"text","value":":","key":"c2tVoHDHlQ"}],"template":"Figure %s:","key":"atiE31P5In"},{"type":"text","value":"Distribution of tidal phases for different tidal types. ","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"iSsGswh6Kq"},{"type":"link","url":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/Tide_type.svg_.png","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":107,"column":1},"end":{"line":107,"column":1}},"key":"GFMMHpJnLb"}],"urlSource":"https://slcc.pressbooks.pub/app/uploads/sites/35/2021/12/Tide_type.svg_.png","key":"ksbHi39I6R"}],"key":"WuB6CSNZ8C"}],"key":"Qw8B6ChKwL"}],"class":"margin-caption","label":"tidalphase","identifier":"tidalphase","enumerator":"5","html_id":"tidalphase","key":"jNta7z1v6b"},{"type":"paragraph","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"link","url":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"UURX5krNGk"}],"urlSource":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","key":"Hlw2BIXo98"}],"key":"NFJ6Gge40m"}],"key":"yoDJJ5pD6H"}],"key":"Fw2yhvLAaR"},"references":{"cite":{"order":[],"data":{}}}}