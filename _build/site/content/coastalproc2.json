ype":"paragraph","children":[{"type":"text","value":"Assess human and natural influences on coastal change.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"Fo5wBBgrDd"}],"key":"o4mhhzIZ8A"}],"key":"CurLEKV3Dx"}],"key":"Ea8IoviJMC"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Watch ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"FVWFmhHcNz"},{"type":"link","url":"https://arcg.is/1jC9q0","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"the StoryMap","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"Fi1PN7p17o"}],"urlSource":"https://arcg.is/1jC9q0","key":"EoCkHGYbsF"},{"type":"text","value":" below for an introduction to today’s lab topic.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"aeoDaxrxwV"}],"key":"gdQLLSnUO7"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://storymaps.arcgis.com/stories/8e8d42bc19d1477a9329a5215afef6a8","width":"100%","key":"aS1iOcK5Yd"}],"key":"bxad60LhnQ"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Coastline Erosion","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"bPe4KK1w6i"}],"identifier":"coastline-erosion","label":"Coastline Erosion","html_id":"coastline-erosion","implicit":true,"key":"Gte4hfbkxr"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Coastline erosion around the world, particularly in large cities, is often at considerable risk. Erosion is often mitigated using a combination of coastal structures that can arrest sediment loss, redirect wave energy, or direct sediment flow along coastlines.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"zprL74MKii"}],"key":"YcN6z9tbZT"},{"type":"heading","depth":2,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Shoreline Structures/Stabilization","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"m5Ow4qxKhg"}],"identifier":"shoreline-structures-stabilization","label":"Shoreline Structures/Stabilization","html_id":"shoreline-structures-stabilization","implicit":true,"key":"j97o3FZU3y"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/e3ZYaL0Q9os","width":"100%","key":"faAEoKOlXw"}],"key":"SYNQThdgrq"},{"type":"heading","depth":3,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Jetties","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"ci0nkYdFqi"}],"identifier":"jetties","label":"Jetties","html_id":"jetties","implicit":true,"key":"cHQms6jEB4"},{"type":"paragraph","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Jetties are large manmade piles of boulders or concrete barriers built at river mouths and harbors. A jetty is designed to divert the current or tide, to keep a channel to the ocean open, and to protect a harbor or beach from wave action.","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"D9Hg4wHcxU"}],"key":"xwKSr31Nmz"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"link","url":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"OnB5jJASgw"}],"urlSource":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","key":"T8DcX5tANh"}],"key":"GHB4nyc9My"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/e661c43ba29e225c8028a6fe4af2fcfd.jpeg","alt":"A view of the Charleston Harbor’s South Jetty. Image source","data":{"altTextIsAutoGenerated":true},"key":"Btuh8Ysq1d","urlSource":"https://www.ccpl.org/cdn-shim/3w3bmkiryxtqk/migration/public/View_of_South_Jetty_June_2022.jpeg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"chasjetties","identifier":"chasjetties","html_id":"chasjetties","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"C5273xsl38"},{"type":"text","value":"1","key":"MSnNrEVnV5"},{"type":"text","value":":","key":"kLm4SnbSfI"}],"template":"Figure %s:","key":"iJv7v4zoe1"},{"type":"text","value":"A view of the Charleston Harbor’s South Jetty. ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"NpHUaI2EtK"},{"type":"link","url":"https://www.ccpl.org/cdn-shim/3w3bmkiryxtqk/migration/public/View_of_South_Jetty_June_2022.jpeg","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"VByHcn8XZP"}],"urlSource":"https://www.ccpl.org/cdn-shim/3w3bmkiryxtqk/migration/public/View_of_South_Jetty_June_2022.jpeg","key":"AWhqGh3dwa"}],"key":"DaXKHIqYya"}],"key":"dBF0E6Woep"}],"class":"margin-caption","label":"chasjetties","identifier":"chasjetties","enumerator":"1","html_id":"chasjetties","key":"Q1PhT2cVRK"},{"type":"image","url":"/7b4fa0167b238a0db69f20dd769f1a33.jpeg","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"l2XJDo1nh0","urlSource":"data:image/jpeg;base64,/9j/4AAQSk.../0oooQz//Z"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Photo Source:","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"cpjFgYcVnK"}],"key":"XRejQut5yD"},{"type":"text","value":" Folly Field Trip Handout F26 (on Oaks)","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"hcYLUxqrgn"}],"key":"TOUQt4TXTK"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"JGGgQOO7dd"},{"type":"link","url":"https://www.ccpl.org/charleston-time-machine/navigating-bar-charleston-harbor-gateway-atlantic","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Charleston Harbor jetties","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"GzRiyCl50r"}],"urlSource":"https://www.ccpl.org/charleston-time-machine/navigating-bar-charleston-harbor-gateway-atlantic","key":"pYK7xbMmqF"},{"type":"text","value":" were constructed by the US Army Corps of Engineers between 1882 and 1895. The purpose of these three-mile-long jetties was to allow safe transit of ships into and out of Charleston Harbor. The construction of these jetties was an engineering marvel at the time and has required few repairs over the past 130 years. However, these jetties disrupted longshore currents, resulting in increased erosion on barrier islands south of the jetties.  One of the most significant landmarks in this area is the Morris Island lighthouse.  When it was first constructed in 1876, it was more than 1200 ft inland from the coastline. Following the construction of the jetties, ocean currents shifted, causing erosion on Morris Island. By 1938, the coastline had receded to the base of the lighthouse.  Eventually, multiple coastal storms and structural damage led to its decommissioning and its eventual addition to the National Register of Historic Places. There are continuing efforts to stabilize the base of this lighthouse.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"n3FssviWcP"}],"key":"ZNWbhnYoFg"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/DE2vtElYSvA","width":"100%","key":"JQT0FEAFng"}],"key":"hZOuqQI6Hr"},{"type":"heading","depth":3,"position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Seawalls","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"wvVsgOrM7L"}],"identifier":"seawalls","label":"Seawalls","html_id":"seawalls","implicit":true,"key":"cJgE4excs7"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Seawalls are onshore structures with the principal function of preventing or alleviating overtopping and flooding of the land and the structures behind due to storm surges and waves. Seawalls are built parallel to the shoreline as a reinforcement of a part of the coastal profile. Quite often, seawalls are used to protect promenades, roads, and houses seaward of the crest edge of the natural beach profile. In these cases, a seawall structure that protrudes vertically or nearly vertically from the beach profile must be built. Seawalls range from vertical-face structures such as massive gravity concrete walls, tied walls using steel or concrete piling, and stone-filled cribwork to sloping structures with typical surfaces of reinforced concrete slabs, concrete armor units, or stone rubble (bulkheads, revetments, and Rip Rap are different types of seawalls).","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"FQte6RlFZU"}],"key":"vYLdBRPR76"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"link","url":"https://courses.ems.psu.edu/earth107/node/1062","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"N3EJbEfgpv"}],"urlSource":"https://courses.ems.psu.edu/earth107/node/1062","key":"uMQJQ8CuON"}],"key":"o5P5tZl62z"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/3db6ae3f0d5d279e27f21d5cce46d7dd.html","alt":"An example of a modern seawall in Ventnor on the Isle of Wight, England. Image source","data":{"altTextIsAutoGenerated":true},"key":"HkWnfhoJmT","urlSource":"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bb/Seawallventnor.jpg/1280px-Seawallventnor.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"seawall","identifier":"seawall","html_id":"seawall","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"iIHV3DMLG7"},{"type":"text","value":"2","key":"fnBANI6o8I"},{"type":"text","value":":","key":"cTrzYsBXFt"}],"template":"Figure %s:","key":"JELjwD7rBz"},{"type":"text","value":"An example of a modern seawall in Ventnor on the Isle of Wight, England. ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"u9SLAX0fbT"},{"type":"link","url":"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bb/Seawallventnor.jpg/1280px-Seawallventnor.jpg","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"HLm0Zypx8C"}],"urlSource":"https://upload.wikimedia.org/wikipedia/commons/thumb/b/bb/Seawallventnor.jpg/1280px-Seawallventnor.jpg","key":"LEeN516pdC"}],"key":"aJjkBSPVoD"}],"key":"j5TuBSGWDx"}],"class":"margin-caption","label":"seawall","identifier":"seawall","enumerator":"2","html_id":"seawall","key":"Wuen37rYU4"},{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Charleston beaches limit seawall construction, but the Charleston Peninsula recently restored one near The Battery. If you haven’t gone to see it, you can check out the details of it in this ","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"Pa94OZPIDd"},{"type":"link","url":"https://storymaps.arcgis.com/stories/bc6e1790933b4c018a52dca8c1daec6a","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"StoryMap","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"F6go4HhfVC"}],"urlSource":"https://storymaps.arcgis.com/stories/bc6e1790933b4c018a52dca8c1daec6a","key":"bYc12oxaCb"},{"type":"text","value":".","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"ap66pE266A"}],"key":"CkLM1mCTUv"},{"type":"heading","depth":3,"position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Groins","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"gDfyosk1mo"}],"identifier":"groins","label":"Groins","html_id":"groins","implicit":true,"key":"SnmzDk8RcF"},{"type":"paragraph","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"children":[{"type":"text","value":"Groins are fences of wire, wood or concrete built across the beach perpendicular to the shoreline and downstream of a property. Unlike jetties, groins are used to preserve sand on a beach rather than to divert it. Sand erodes on the downstream side of the groin and collects against the upstream side. Every groin on one property thus creates a need for another one on the property downstream. A series of groins along a beach develops a scalloped appearance along the shoreline.","position":{"start":{"line":80,"column":1},"end":{"line":80,"column":1}},"key":"shX5VxxHX4"}],"key":"DB5qDsWk5s"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/32cee3f168d944316a96d3b688eb088d.html","alt":"An example of a groin structure used to slow coastal erosion. Image source","data":{"altTextIsAutoGenerated":true},"key":"r9C6ZdeaQS","urlSource":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/41/Sea_Bright_Beach_Jetty.jpg/250px-Sea_Bright_Beach_Jetty.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"An example of a groin structure used to slow coastal erosion. ","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"m92cif2DTR"},{"type":"link","url":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/41/Sea_Bright_Beach_Jetty.jpg/250px-Sea_Bright_Beach_Jetty.jpg","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"jdVNhvlkJJ"}],"urlSource":"https://upload.wikimedia.org/wikipedia/commons/thumb/4/41/Sea_Bright_Beach_Jetty.jpg/250px-Sea_Bright_Beach_Jetty.jpg","key":"OnMpEvmObs"}],"key":"aJIjQtCPwi"}],"key":"mltqFxLUpA"}],"class":"margin-caption","label":"groins","identifier":"groins","enumerator":"3","html_id":"groins","key":"T1bixgS0fC"},{"type":"paragraph","position":{"start":{"line":90,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"link","url":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"zDxhzIZxBx"}],"urlSource":"https://slcc.pressbooks.pub/introgeology/chapter/12-shorelines/","key":"kJvYtfRr4I"},{"type":"text","value":"\n","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"bqRsxYRKJ3"},{"type":"link","url":"https://opentextbc.ca/physicalgeology2ed/chapter/17-5-human-interference-with-shorelines/","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":90,"column":1},"end":{"line":90,"column":1}},"key":"taTuMGR1jo"}],"urlSource":"https://opentextbc.ca/physicalgeology2ed/chapter/17-5-human-interference-with-shorelines/","key":"PQ8cGxdHzZ"}],"key":"pARCvURdEs"},{"type":"heading","depth":3,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"Beach Renourishment","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"yIdnr7k7pN"}],"identifier":"beach-renourishment","label":"Beach Renourishment","html_id":"beach-renourishment","implicit":true,"key":"vXQt2JaCwd"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"Shore nourishments can be regarded as a ‘natural’ way of combating dune and beach erosion, as they artificially replace a deficit in the sediment budget along a certain coastal stretch with a corresponding volume of sand. A structural deficit in the sediment budget is generally due to divergence of longshore sediment transport. Shore nourishment does not eliminate this cause of erosion; erosion will continue, and the nourished sand will be carried away. It is thus inherent in the concept of nourishment that the nourished sand is gradually sacrificed. This means that nourishment, as a stand-alone method, normally requires ongoing maintenance. In general, nourishment is only suited for shoreline sections of substantial length; otherwise, the loss of sand to neighboring sections will be too large. Regular nourishment requires a permanent, well-functioning organization, which makes nourishment as a stand-alone solution unsuitable for privately owned coastlines.","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"bLhbVS0yve"}],"key":"gb2MH6rBoS"},{"type":"paragraph","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"link","url":"https://www.coastalwiki.org/wiki/Shore_nourishment","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"xUzsCnZZPr"}],"urlSource":"https://www.coastalwiki.org/wiki/Shore_nourishment","key":"lPWmKxqufl"}],"key":"LY39Y1Qu6p"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/ecf7b32e9e084ed36ff3ba81f5ff02c7.html","alt":"Sand is pumped from the seafloor to renourish a beach. Image source","data":{"altTextIsAutoGenerated":true},"key":"c6F7Av7RDH","urlSource":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fe/Beach_restoration_device.jpg/1280px-Beach_restoration_device.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"beachrenourish","identifier":"beachrenourish","html_id":"beachrenourish","enumerator":"4","children":[{"type":"text","value":"Figure ","key":"oFU2TDHQsI"},{"type":"text","value":"4","key":"Qwmeu29PLU"},{"type":"text","value":":","key":"mOojRFUSuc"}],"template":"Figure %s:","key":"Uybf7GAUsN"},{"type":"text","value":"Sand is pumped from the seafloor to renourish a beach. ","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"RskVsscJeP"},{"type":"link","url":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fe/Beach_restoration_device.jpg/1280px-Beach_restoration_device.jpg","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":104,"column":1},"end":{"line":104,"column":1}},"key":"SAzomtIJEi"}],"urlSource":"https://upload.wikimedia.org/wikipedia/commons/thumb/f/fe/Beach_restoration_device.jpg/1280px-Beach_restoration_device.jpg","key":"tsNSeg0eXf"}],"key":"LVLV6Kmd2r"}],"key":"XebV21ygeA"}],"class":"margin-caption","label":"beachrenourish","identifier":"beachrenourish","enumerator":"4","html_id":"beachrenourish","key":"aNbIYWBl3t"},{"type":"heading","depth":2,"position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"children":[{"type":"text","value":"Shoreline Erosion Features","position":{"start":{"line":108,"column":1},"end":{"line":108,"column":1}},"key":"VYQvWBjsJ5"}],"identifier":"shoreline-erosion-features","label":"Shoreline Erosion Features","html_id":"shoreline-erosion-features","implicit":true,"key":"FM0R7qN1pT"},{"type":"heading","depth":3,"position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"Washover Fans","position":{"start":{"line":110,"column":1},"end":{"line":110,"column":1}},"key":"ChZT5vSOGS"}],"identifier":"washover-fans","label":"Washover Fans","html_id":"washover-fans","implicit":true,"key":"snIbMcAHcX"},{"type":"paragraph","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"children":[{"type":"text","value":"When storm-induced waves exceed the height of the dune, sand is transported over top of the dune and deposited inland. This process, known as overwash, causes a significant change in the landscape of the island.  During the overwash process, portions of the dune are often completely eroded, and sand is deposited inland in large layers called overwash fans. These fans can bury the first floors of homes, cover roads, fill ponds, and cover coastal vegetation. Depending on the severity of the storm and the width of the island, these overwash fans can extend the entire width of the island. When sand is transported from the seaward to the landward side of the island, the island migrates landward in a process known as barrier island rollover.","position":{"start":{"line":112,"column":1},"end":{"line":112,"column":1}},"key":"NbtUS7Dguw"}],"key":"xY7enfxU1r"},{"type":"paragraph","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"link","url":"https://coastal.er.usgs.gov/hurricanes/coastal-change/overwash.php","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":114,"column":1},"end":{"line":114,"column":1}},"key":"RXjy3jxCqZ"}],"urlSource":"https://coastal.er.usgs.gov/hurricanes/coastal-change/overwash.php","key":"AFOIuWqehG"}],"key":"L0JN0gWd5a"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/72bc1f2c8dadde7161dfe70c5e6c89d6.jpeg","alt":"Dramatic shoreline erosion and large overwash deposits along Dauphin Island during Hurricane Katrina (2005) demonstrate classic barrier island rollover. Image source","data":{"altTextIsAutoGenerated":true},"key":"UuNDHfGZbR","urlSource":"https://coastal.er.usgs.gov/hurricanes/images/breachLG.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"overwash","identifier":"overwash","html_id":"overwash","enumerator":"5","children":[{"type":"text","value":"Figure ","key":"L3fAMjhkCh"},{"type":"text","value":"5","key":"GgRYrQk0yK"},{"type":"text","value":":","key":"KlM88oxsWR"}],"template":"Figure %s:","key":"RbDl2X3yii"},{"type":"text","value":"Dramatic shoreline erosion and large overwash deposits along Dauphin Island during Hurricane Katrina (2005) demonstrate classic barrier island rollover. ","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"aB2kpODVZN"},{"type":"link","url":"https://coastal.er.usgs.gov/hurricanes/images/breachLG.jpg","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"yIg4xlm7Jy"}],"urlSource":"https://coastal.er.usgs.gov/hurricanes/images/breachLG.jpg","key":"DVlayqY99W"}],"key":"yWQKrbNFCa"}],"key":"nMUOPYjNZI"}],"class":"margin-caption","label":"overwash","identifier":"overwash","enumerator":"5","html_id":"overwash","key":"wyVcTuW3EJ"},{"type":"paragraph","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"children":[{"type":"text","value":"At Folly Beach, these deposits are found in the maritime forest and serve as evidence of major storm events. They indicate barrier-island migration (called island rollover), meaning the island is in an erosional stage.","position":{"start":{"line":124,"column":1},"end":{"line":124,"column":1}},"key":"TQtENUahGy"}],"key":"pGB9VraTv2"},{"type":"heading","depth":3,"position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"children":[{"type":"text","value":"Boneyard Beach","position":{"start":{"line":126,"column":1},"end":{"line":126,"column":1}},"key":"jtwHGlnAuS"}],"identifier":"boneyard-beach","label":"Boneyard Beach","html_id":"boneyard-beach","implicit":true,"key":"zp23DvwPlh"},{"type":"paragraph","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"children":[{"type":"text","value":"A boneyard beach is a shoreline where the remains of a former maritime forest have been exposed by coastal erosion. Saltwater intrusion kills the trees, and continued exposure to salt, sun, and wind bleaches the wood, creating their distinctive skeletal appearance. These exposed tree remains are a visible indicator of long-term shoreline retreat and erosion.","position":{"start":{"line":128,"column":1},"end":{"line":128,"column":1}},"key":"AMx47YUNNs"}],"key":"oqMmdKLPx4"},{"type":"paragraph","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"image","url":"/a6b61782e2d074fa3b5cf8ff1b50c5f1.png","alt":"Title: http://st.hzcdn.com/simgs/8291f70e04eb8947_4-2252/contemporary-fine-art-prints.jpg","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"AXNNpYXufw","urlSource":"data:image/png;base64,iVBORw0KGg...VORK5CYII="},{"type":"strong","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"children":[{"type":"text","value":"Photo Source","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"ZMwtiGqLc3"}],"key":"WWr6znAccs"},{"type":"text","value":": Folly Field Trip Handout F26 (on Oaks)","position":{"start":{"line":130,"column":1},"end":{"line":130,"column":1}},"key":"spm6DYN4GX"}],"key":"ioVP6DB3XG"},{"type":"heading","depth":3,"position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"Sand Dunes","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"H731rg7144"}],"identifier":"sand-dunes","label":"Sand Dunes","html_id":"sand-dunes","implicit":true,"key":"PlWV11Sy06"},{"type":"paragraph","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"Sand dunes are mounds or ridges of wind-blown sand that form above the high tide line. They often begin when wrack (dead seaweed and other organic material) traps wind-blown sand and sea oat seeds, allowing vegetation to establish and stabilize a primary dune. Dunes act as natural barriers by absorbing wave energy, reducing erosion, and protecting inland areas from storm surge and flooding. Where dune faces have been cut away, they are called ","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"dcI5Oirpxz"},{"type":"strong","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"truncated dunes","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"etbJfoxb15"}],"key":"CdVOGMsFYc"},{"type":"text","value":", which indicate the shoreline is experiencing erosion. Along the Folly Beach shoreline, you can also observe sea oat root systems exposed within the sand and cross-bedding preserved in the dune deposits.","position":{"start":{"line":135,"column":1},"end":{"line":135,"column":1}},"key":"lpVtSrqrXp"}],"key":"Zbr5jvQ6iA"},{"type":"image","url":"/995a6422bb495aec567bfe2c736e59ed.png","alt":"Title: 20160525_172708.jpg","position":{"start":{"line":138,"column":1},"end":{"line":138,"column":1}},"key":"eM10GOHpLn","urlSource":"data:image/png;base64,iVBORw0KGg...5ErkJggg=="},{"type":"paragraph","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"strong","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Photo Source:","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"TgigUIqtiC"}],"key":"IqPtlfnD6K"},{"type":"text","value":" Folly Field Trip Handout F26 (on Oaks)","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"ZVRXQ1w3VH"}],"key":"LCqi56ATbv"}],"key":"EqtioWCOUw"}],"key":"WJhzpx4viZ"},"references":{"cite":{"order":[],"data":{}}}}