{"version":3,"kind":"Article","sha256":"2aab4d05b8086f7196b35ba83b4dc8c38963e5ea9ed49ec7eb5720524dc0cc82","slug":"coastalproc2","location":"/08CoastalProc2.md","dependencies":[],"frontmatter":{"title":"8 Coastal Erosion","content_includes_title":false,"github":"https://github.com/vijayvulava/103L","keywords":["geology","lab manual","environmental geology"],"math":{},"thumbnail":"/e661c43ba29e225c8028a6fe4af2fcfd.jpeg","exports":[{"format":"md","filename":"08CoastalProc2.md","url":"/08CoastalProc2-c1a76b8ee6c42b26f89d09054824c329.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"In this lab, we will take a virtual field trip to Folly Beach to explore the processes that shape barrier islands and coastlines. We will examine evidence of erosion, sediment transport, and coastal engineering to understand how both natural processes and human activities influence shoreline change over time.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"uEFCWkEPtT"}],"key":"EHCbUxkvzN"},{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Learning Objectives","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"WxP09BOgib"}],"identifier":"learning-objectives","label":"Learning Objectives","html_id":"learning-objectives","implicit":true,"key":"Zi8QsayAjC"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Students will learn and demonstrate their understanding of:","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"MXDRtlGkxH"}],"key":"VyGSvIoUTf"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":9,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"listItem","spread":true,