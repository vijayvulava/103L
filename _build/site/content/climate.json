{"version":3,"kind":"Article","sha256":"c654ffcb3b9a35a250aedb73efcf24c2513f381c95e05f5c3a79f017fe387f37","slug":"climate","location":"/10Climate.md","dependencies":[],"frontmatter":{"title":"10 Climate Change","content_includes_title":false,"github":"https://github.com/vijayvulava/103L","keywords":["geology","lab manual","environmental geology"],"math":{},"thumbnail":"/0e75ae1ce1fc5c15cd82cf6cbe8d82d6.png","exports":[{"format":"md","filename":"10Climate.md","url":"/10Climate-8369fca0a676a4298cf4d5632d144115.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"In this lab, we learn about the basic ideas behind climate change, common misconceptions, and the consequences of global change. Addressing global change requires collective efforts from individuals, communities, governments, and international communities. Sustainable development, conservation practices, renewable energy adoption, responsible land-use planning, and global cooperation on climate action and biodiversity conservation are crucial for mitigating the negative impacts of global change and promoting a more sustainable and resilient future.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iipH1AgfuI"}],"key":"y82LdkHEyj"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Learning Objectives","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xBxqevU3MB"}],"identifier":"learning-objectives","label":"Learning Objectives","html_id":"learning-objectives","implicit":true,"key":"WcxsZNYoy5"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Students will learn and demonstrate their understanding of:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"CPTFQrzg7S"}],"key":"rOJqHJTRNP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":8,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Differentiate between climate and weather.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ofH20Fe76j"}],"key":"qaCGkPc5Jg"}],"key":"OXQfn5EI07"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Identify major factors that control global climate.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"WIdFaC1rKO"}],"key":"A9bxKgEOQB"}],"key":"NraMSAiN1l"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Analyze trends in temperature, sea level, and cryosphere data.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"Df5BwKDVuR"}],"key":"Swj2WeEcp8"}],"key":"QmnVpNWIVi"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Interpret graphs and datasets related to climate change indicators.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"OVwjGIaiLF"}],"key":"iqdsDBNCDu"}],"key":"OzzICu8NSY"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Evaluate sources and impacts of greenhouse gas emissions.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"UZu9fEYPBr"}],"key":"O7guqJi6FQ"}],"key":"ozjfWRSwvG"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Assess evidence supporting anthropogenic climate change.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"wsY9lDSbv6"}],"key":"TIuJsb3n16"}],"key":"r87XDdFOq9"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Predict potential environmental and societal consequences of climate change.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"XbQnMy4XBL"}],"key":"g5ahoT1GXE"}],"key":"qQqxy9Z0Ja"}],"key":"rluh4KLWiT"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Watch ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"rJNDtOHlOb"},{"type":"link","url":"https://arcg.is/1b5v44","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"the StoryMap","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"kTgcEXujKY"}],"urlSource":"https://arcg.is/1b5v44","key":"ouZJvy6W7P"},{"type":"text","value":" below for an introduction to today’s lab topic.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"ZKxEoy4fD0"}],"key":"BQlRoHcHee"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://storymaps.arcgis.com/stories/4f4838965c1444eea6135413116cf879","width":"100%","key":"fOd75iJ3IH"}],"key":"FjC7R41d7S"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Weather vs Climate","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"ne7nw9HmMo"}],"identifier":"weather-vs-climate","label":"Weather vs Climate","html_id":"weather-vs-climate","implicit":true,"key":"EoBtNxHsjZ"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"It is critically important for us to be aware of the geologic context of climate change processes and how these Earth systems interact, first, for us to understand how and why human activities cause present-day climate change and, secondly, to distinguish between natural processes and human processes in the geologic past’s climate record.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"xqFoBYss3X"}],"key":"mhhIQQdVAv"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Also necessary to understanding climate change is to distinguish between climate and weather. Weather is the short-term temperature and precipitation patterns that occur in days  and weeks. Climate is the variable range of temperature and precipitation patterns averaged over the long-term for a particular region. Thus, a single cold winter does not mean that the entire globe is cooling—indeed, the United States’ cold winters of 2013 and 2014 occurred  while the rest of the Earth was experiencing record warm-winter temperatures. To avoid these generalizations, many scientists use a 30-year average as a good baseline. Therefore, climate change refers to slow temperature and precipitation changes and trends over the long term for a particular area or the Earth as a whole.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"OKfNM8FomR"}],"key":"Z9c4xCbeSs"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"link","url":"https://slcc.pressbooks.pub/introgeology/chapter/15-global-climate-change/","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"x0Aes4hrcK"}],"urlSource":"https://slcc.pressbooks.pub/introgeology/chapter/15-global-climate-change/","key":"K7FqTtSQ3H"}],"key":"iz979xvc2R"},{"type":"heading","depth":2,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Factors Impacting Climate","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"ceWVtEnKSy"}],"identifier":"factors-impacting-climate","label":"Factors Impacting Climate","html_id":"factors-impacting-climate","implicit":true,"key":"z3Ii5gRSZv"},{"type":"heading","depth":3,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Carbon Cycle","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"qCLk3w4FM8"}],"identifier":"carbon-cycle","label":"Carbon Cycle","html_id":"carbon-cycle","implicit":true,"key":"NlWIyfkDhR"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Critical to understanding global climate change is to understand the carbon cycle and how Earth’s own carbon-balancing system is being rapidly thrown off balance by human-driven activities. Earth has two important carbon cycles: the biological and the geological. In the biological cycle, living organisms—mostly plants—consume carbon dioxide from the atmosphere to make their tissues and substances through photosynthesis. Then, after the organisms die, and when they decay over years or decades, that carbon is released back into the atmosphere. The following is the general equation for photosynthesis.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"qCU5n3fVZa"}],"key":"L7LxCwXvhR"},{"type":"math","value":"\\ce{CO2 + H2O + Sunlight →  Sugars + O2}","position":{"start":{"line":37,"column":1},"end":{"line":38,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mrow><mi mathvariant=\"normal\">C</mi><mi mathvariant=\"normal\">O</mi></mrow><msub><mpadded width=\"0px\"><mphantom><mi>X</mi></mphantom></mpadded><mpadded height=\"0px\"><mn>2</mn></mpadded></msub><mrow></mrow><mo>+</mo><mrow></mrow><mi mathvariant=\"normal\">H</mi><msub><mpadded width=\"0px\"><mphantom><mi>X</mi></mphantom></mpadded><mpadded height=\"0px\"><mn>2</mn></mpadded></msub><mi mathvariant=\"normal\">O</mi><mrow></mrow><mo>+</mo><mrow></mrow><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">n</mi><mi mathvariant=\"normal\">l</mi><mi mathvariant=\"normal\">i</mi><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">h</mi><mi mathvariant=\"normal\">t</mi></mrow><mover><mo stretchy=\"true\" minsize=\"3.0em\">→</mo><mpadded width=\"+0.6em\" lspace=\"0.3em\"><mrow></mrow></mpadded></mover><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">u</mi><mi mathvariant=\"normal\">g</mi><mi mathvariant=\"normal\">a</mi><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">s</mi></mrow><mrow></mrow><mo>+</mo><mrow></mrow><mi mathvariant=\"normal\">O</mi><msub><mpadded width=\"0px\"><mphantom><mi>X</mi></mphantom></mpadded><mpadded height=\"0px\"><mn>2</mn></mpadded></msub></mrow><annotation encoding=\"application/x-tex\">\\ce{CO2 + H2O + Sunlight →  Sugars + O2}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathrm\">CO</span></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord rlap\"><span class=\"inner\"><span class=\"mord\" style=\"color:transparent;\"><span class=\"mord