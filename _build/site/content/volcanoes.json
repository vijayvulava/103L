{"version":3,"kind":"Article","sha256":"e1de03b074f0ce11b0b6918416f8d69e3d3bf9d98eaba482beefb6c383d3ad68","slug":"volcanoes","location":"/04Volcanoes.md","dependencies":[],"frontmatter":{"title":"4 Volcanoes","content_includes_title":false,"github":"https://github.com/vijayvulava/103L","keywords":["geology","lab manual","environmental geology"],"math":{},"thumbnail":"/mt-st-helens-38-yrs-a6ab6a2c60b8cf7218ca8d39e0cec6f3.png","exports":[{"format":"md","filename":"04Volcanoes.md","url":"/04Volcanoes-0abf0302e8de72badb31198a70c5aa94.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"In this lab, we will focus on learning about volcanoes and how the theory of plate tectonics helps us understand why they occur. We will also learn about two major types of volcanoes and the typical hazards associated with such volcanoes. Igneous rocks are associated with these volcanic environments; therefore, we will also learn about the most common types of igneous rocks in these environments.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tO6vULYu23"}],"key":"jsHWlX582v"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Learning Objectives","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"kI9ObDgMxg"}],"identifier":"learning-objectives","label":"Learning Objectives","html_id":"learning-objectives","implicit":true,"key":"g5icyYE7vP"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Students will learn and demonstrate their understanding of:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"rWQHMJw1Kb"}],"key":"LFEyoldiT4"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line"