ion":{"start":{"line":13,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Classify igneous rocks by composition and texture and relate them to tectonic settings.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"cC4lg8F3yl"}],"key":"gS2D8thwXe"}],"key":"V9lkwS0s4o"}],"key":"lMuF96g17g"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Watch ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"FgtNeIMAf1"},{"type":"link","url":"https://arcg.is/11SS444","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"the StoryMap","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"cngOdW74lN"}],"urlSource":"https://arcg.is/11SS444","key":"wADIdVDVqN"},{"type":"text","value":" below for an introduction to today’s lab topic.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"pIDl2wNC7y"}],"key":"kW2SqatWp7"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://storymaps.arcgis.com/stories/caa715c868ce4416adbca14a39994f0f","width":"100%","key":"putRjcP8kO"}],"key":"HsrRnoxaQH"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"What is a Volcano?","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"SX1l4cJABb"}],"identifier":"what-is-a-volcano","label":"What is a Volcano?","html_id":"what-is-a-volcano","implicit":true,"key":"llIqQN1fnQ"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"A volcano is any location where magma comes to the surface, or has done so within the past several million years. This can include eruptions on the ocean floor (or even underwater in a lake), called subaqueous eruptions, or on land, called subaerial eruptions. Not all volcanic eruptions produce the volcanic mountains with which we are familiar; in fact, most of Earth’s volcanism takes place along the spreading ridges on the sea floor and does not produce volcanic mountains at all—not even sea-floor mountains.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"JP0BWHfubn"}],"key":"vPZik73cyt"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"link","url":"https://opentextbc.ca/physicalgeology2ed/chapter/4-3-types-of-volcanoes/","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"https://opentextbc.ca/physicalgeology2ed/chapter/4-3-types-of-volcanoes/","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"ujIh1D9cVL"}],"key":"iTsdvhh9PP"}],"urlSource":"https://opentextbc.ca/physicalgeology2ed/chapter/4-3-types-of-volcanoes/","key":"fzSQnjKx0t"}],"key":"rEh568pJBJ"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Types of Volcanoes","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"geDLbMXkds"}],"identifier":"types-of-volcanoes","label":"Types of Volcanoes","html_id":"types-of-volcanoes","implicit":true,"key":"nCG3CePSxm"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/VNGUdObDoLk","width":"100%","key":"EttKiaJPUE"}],"key":"Qq3lLyZYuH"},{"type":"heading","depth":3,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Composite Volcanoes","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"vWnvoqB2z1"}],"identifier":"composite-volcanoes","label":"Composite Volcanoes","html_id":"composite-volcanoes","implicit":true,"key":"onlCqFJ1yC"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Composite volcanoes, like Mount St. Helens in Washington State, are almost all associated with subduction at convergent plate boundaries—either ocean-continent or ocean-ocean boundaries. They can extend up to several thousand meters beyond the surrounding terrain and, with slopes up to 30˚, can be up to about 20 km across.   At many such volcanoes, magma is stored in a magma chamber in the upper part of the crust. For example, at Mount St. Helens, there is evidence of a magma chamber approximately 1 kilometer wide that extends from about 6 km to 14 km below the surface. Systematic variations in the composition of volcanism over the past several thousand years at Mount St. Helens imply that the magma chamber is zoned, from more felsic at the top to more mafic at the bottom.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"YHTiRgcgEZ"}],"key":"SbVgyGlUuz"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/mt-st-helens-38-yrs-a6ab6a2c60b8cf7218ca8d39e0cec6f3.png","alt":"The north side of Mount St. Helens in southwestern Washington State, 2003. The large 1980 eruption reduced the volcano’s height by 400 m, and a sector collapse removed a large part of the northern flank. Between 1980 and 1986, the slow eruption of more mafic, less viscous lava led to the formation of a dome within the crater. Image source","data":{"altTextIsAutoGenerated":true},"key":"kb5FvexvOf","urlSource":"assets/mt-st-helens-38-yrs.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"mtsthelens","identifier":"mtsthelens","html_id":"mtsthelens","enumerator":"1","children":[{"type":"text","value":"Figure ","key":"GRHJQU5ZLH"},{"type":"text","value":"1","key":"up4I1vp3l9"},{"type":"text","value":":","key":"MW5w8Qro6g"}],"template":"Figure %s:","key":"rg9cc2aQdB"},{"type":"text","value":"The north side of Mount St. Helens in southwestern Washington State, 2003. The large 1980 eruption reduced the volcano’s height by 400 m, and a sector collapse removed a large part of the northern flank. Between 1980 and 1986, the slow eruption of more mafic, less viscous lava led to the formation of a dome within the crater. ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"RttJGVa4ic"},{"type":"link","url":"https://www.usgs.gov/media/images/mount-st-helens-erupted-38-years-ago-may-18-1980","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"RXDmS7JD47"}],"urlSource":"https://www.usgs.gov/media/images/mount-st-helens-erupted-38-years-ago-may-18-1980","key":"bogMtOqEIq"}],"key":"o2nmciyMdg"}],"key":"cnTfyC32Aw"}],"class":"margin-caption","label":"mtsthelens","identifier":"mtsthelens","enumerator":"1","html_id":"mtsthelens","key":"OOIYmZXA6L"},{"type":"heading","depth":3,"position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Shield Volcanoes","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"paKjqfqDC1"}],"identifier":"shield-volcanoes","label":"Shield Volcanoes","html_id":"shield-volcanoes","implicit":true,"key":"eEIfY5ti7e"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Most shield volcanoes are associated with mantle plumes, although some form at divergent boundaries, either on land or on the sea floor. Because of their non-viscous mafic magma, they tend to have relatively gentle slopes (2 to 10˚), and the larger ones can be over 100 km in diameter. The best-known shield volcanoes are those that make up the Hawaiian Islands, and of these, the only active ones are on the Big Island of Hawaii. Mauna Loa, the world’s largest volcano and the world’s largest mountain (by volume), last erupted in 1984. Kilauea, arguably the world’s most active volcano, has been erupting, virtually without interruption, since 1983. Loihi is an underwater volcano on the southeastern side of Hawaii. It is last known to have erupted in 1996, but may have erupted since then without being detected.","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"K7BwIDK7Ea"}],"key":"GTjVow8gpv"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"All of the Hawaiian volcanoes are related to the mantle plume that currently lies beneath Mauna Loa, Kilauea, and Loihi. In this area, the Pacific Plate is moving northwest at a rate of about 7 centimeters (cm) per year. This means that the earlier-formed, now-extinct volcanoes have moved well away from the mantle plume. There is evidence of crustal magma chambers beneath all three active Hawaiian volcanoes. At Kilauea, the magma chamber appears to be several kilometers in diameter and is situated between 8 km and 11 km below the surface.","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"hhQFGn5jwx"}],"key":"QSbXvTkoR8"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/Kilauea-eruption-nps-5096022e5a5478c4c177b519ff683adc.jpg","alt":"Kīlauea erupting with Mauna Loa volcano in a distance. Fountains of lava erupting several hundred feet in the air on December 23, 2024.  Image source","data":{"altTextIsAutoGenerated":true},"key":"kz5oPIFFvc","urlSource":"assets/Kilauea-eruption-nps.jpg"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"kilauea","identifier":"kilauea","html_id":"kilauea","enumerator":"2","children":[{"type":"text","value":"Figure ","key":"UIA1mEXlZY"},{"type":"text","value":"2","key":"gsr4WGz7cS"},{"type":"text","value":":","key":"yT3KWolSPX"}],"template":"Figure %s:","key":"Qr1htX4U7w"},{"type":"text","value":"Kīlauea erupting with Mauna Loa volcano in a distance. Fountains of lava erupting several hundred feet in the air on December 23, 2024.  ","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"B866EFiYTp"},{"type":"link","url":"https://www.nps.gov/havo/index.htm","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"Image source","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"SrYTYseT7E"}],"urlSource":"https://www.nps.gov/havo/index.htm","key":"fvRe9KMrqc"}],"key":"OvZQztAD2p"}],"key":"RkXkTIkgKr"}],"class":"margin-caption","label":"kilauea","identifier":"kilauea","enumerator":"2","html_id":"kilauea","key":"UtgPpy6Qoz"},{"type":"paragraph","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"link","url":"https://opentextbc.ca/physicalgeology2ed/chapter/4-3-types-of-volcanoes/","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"children":[{"type":"text","value":"Text Source","position":{"start":{"line":62,"column":1},"end":{"line":62,"column":1}},"key":"VbGha7f5jk"}],"urlSource":"https://opentextbc.ca/physicalgeology2ed/chapter/4-3-types-of-volcanoes/","key":"deG8P91Rch"}],"key":"lS2FxdJZU5"},{"type":"div","class":"container","children":[{"type":"iframe","class":"video","src":"https://www.youtube.com/embed/AhSaE0omw9o","width":"100%","key":"ael9bfs0qz"}],"key":"xrgnrtE6HF"},{"type":"heading","depth":2,"position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"P